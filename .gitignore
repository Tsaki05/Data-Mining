# --- Entorn virtual de Python (cada membre el crea al seu ordinador) ---
.venv/
venv/

# --- Dades: NO es pugen al repositori ---
# Els CSV originals es descarreguen de Kaggle (enllaç al README) i les taules
# intermèdies es regeneren amb els notebooks. GitHub no accepta fitxers de més
# de 100 MB.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# --- Fitxers temporals de Jupyter i Python ---
.ipynb_checkpoints/
__pycache__/
*.pyc

# --- Fitxers del sistema ---
Thumbs.db
desktop.ini
.DS_Store
